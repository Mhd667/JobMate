# Supabase > Project settings > Database > Connection string > "Transaction pooler" (port 6543), psycopg driver
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<ref>.supabase.co
AUTH_PROVIDER=supabase
# Only for legacy projects that still sign JWTs with HS256:
# SUPABASE_JWT_SECRET=
CORS_ORIGINS=https://<frontend>.vercel.app,http://localhost:3000

INTELLIGENCE_MODE=llm
LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b     (default for groq)
GROQ_API_KEY=
# LLM_PROVIDER=anthropic  +  ANTHROPIC_API_KEY=   to use Claude instead
# error (default): the API answers 502/503 when the LLM fails; heuristic: degrade to the rule-based layer
LLM_FALLBACK=error
